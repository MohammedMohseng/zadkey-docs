# Local development overrides
# lvh.me (and any *.lvh.me) resolves to 127.0.0.1 via public DNS — unlike bare
# "localhost", it's a real multi-label domain, so Domain-scoped cookies actually
# cascade to subdomains here the way they do with ".zadkey.com" in production.
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000
NEXT_PUBLIC_COOKIE_DOMAIN=.lvh.me
NEXT_PUBLIC_APP_PROTOCOL=http

# Prisma / Database — Postgres المحلي نفسه الذي يديره supabase start (منفذ 54322)
